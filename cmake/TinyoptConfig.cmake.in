# - Config file for the Tinyopt library
# It defines the following variables:
#  Tinyopt_FOUND - True if Tinyopt has been found
#  Tinyopt_INCLUDE_DIRS - The include directories for Tinyopt
#  Tinyopt_VERSION - The version of Tinyopt
#  Tinyopt_VERSION_MAJOR - Major version component
#  Tinyopt_VERSION_MINOR - Minor version component
#  Tinyopt_VERSION_PATCH - Patch version component
#  Tinyopt_LIBRARIES - (For header-only, this will likely be empty)
#
# It also imports the target Eigen3::Eigen if found.

@PACKAGE_INIT@

# Handle component-based finds
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 REQUIRED COMPONENTS Eigen)
if(@TINYOPT_ENABLE_SUITESPARSE@)
  enable_language(C)
  find_dependency(CHOLMOD CONFIG REQUIRED)
endif()

# Set the include directories relative to the installed prefix.
set(Tinyopt_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")

# For a header-only library, there are no libraries to link against directly.
set(Tinyopt_LIBRARIES "")

# Set the version variables
set(Tinyopt_VERSION "@TINYOPT_VERSION_STRING@")
string(REGEX MATCHALL "([0-9]+)\\.([0-9]+)\\.([0-9]+)" Tinyopt_VERSION_MATCH "${Tinyopt_VERSION}")
if(Tinyopt_VERSION_MATCH)
  set(Tinyopt_VERSION_MAJOR "${CMAKE_MATCH_1}")
  set(Tinyopt_VERSION_MINOR "${CMAKE_MATCH_2}")
  set(Tinyopt_VERSION_PATCH "${CMAKE_MATCH_3}")
endif()

# Define the Tinyopt target
include("${CMAKE_CURRENT_LIST_DIR}/TinyoptTargets.cmake")

set(_tinyopt_optimizer_definitions)
if(@TINYOPT_ENABLE_GAUSS_NEWTON@)
  list(APPEND _tinyopt_optimizer_definitions TINYOPT_ENABLE_GAUSS_NEWTON=1)
endif()
if(@TINYOPT_ENABLE_GRADIENT_DESCENT@)
  list(APPEND _tinyopt_optimizer_definitions TINYOPT_ENABLE_GRADIENT_DESCENT=1)
endif()
if(@TINYOPT_ENABLE_CONJUGATE_GRADIENT@)
  list(APPEND _tinyopt_optimizer_definitions TINYOPT_ENABLE_CONJUGATE_GRADIENT=1)
endif()
if(@TINYOPT_ENABLE_DOGLEG@)
  list(APPEND _tinyopt_optimizer_definitions TINYOPT_ENABLE_DOGLEG=1)
endif()
if(@TINYOPT_ENABLE_BFGS@)
  list(APPEND _tinyopt_optimizer_definitions TINYOPT_ENABLE_BFGS=1)
endif()
if(@TINYOPT_ENABLE_LBFGS@)
  list(APPEND _tinyopt_optimizer_definitions TINYOPT_ENABLE_LBFGS=1)
endif()
set_property(TARGET tinyopt APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS
  "${_tinyopt_optimizer_definitions}")

set(_tinyopt_linear_solver_definitions)
if(@TINYOPT_ENABLE_LINEAR_SOLVER_LDLT@)
  list(APPEND _tinyopt_linear_solver_definitions TINYOPT_ENABLE_LINEAR_SOLVER_LDLT=1)
endif()
if(@TINYOPT_ENABLE_LINEAR_SOLVER_LLT@)
  list(APPEND _tinyopt_linear_solver_definitions TINYOPT_ENABLE_LINEAR_SOLVER_LLT=1)
endif()
if(@TINYOPT_ENABLE_LINEAR_SOLVER_LU@)
  list(APPEND _tinyopt_linear_solver_definitions TINYOPT_ENABLE_LINEAR_SOLVER_LU=1)
endif()
if(@TINYOPT_ENABLE_LINEAR_SOLVER_QR@)
  list(APPEND _tinyopt_linear_solver_definitions TINYOPT_ENABLE_LINEAR_SOLVER_QR=1)
endif()
if(@TINYOPT_ENABLE_LINEAR_SOLVER_SVD@)
  list(APPEND _tinyopt_linear_solver_definitions TINYOPT_ENABLE_LINEAR_SOLVER_SVD=1)
endif()
if(@TINYOPT_ENABLE_SUITESPARSE@)
  list(APPEND _tinyopt_linear_solver_definitions TINYOPT_ENABLE_SUITESPARSE=1)
  set_property(TARGET tinyopt APPEND PROPERTY INTERFACE_LINK_LIBRARIES SuiteSparse::CHOLMOD)
endif()
set_property(TARGET tinyopt APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS
  "${_tinyopt_linear_solver_definitions}")

# Set the FOUND variable
set(Tinyopt_FOUND TRUE)

# Inform the user about the found package
if(NOT CMAKE_SUPPRESS_PACKAGE_FIND_MESSAGES)
  message(STATUS "Found Tinyopt: ${Tinyopt_VERSION} (include: ${Tinyopt_INCLUDE_DIRS})")
endif()